# NanoClaw v2 — NAS deployment. Copy to .env and fill the blanks.
# The real .env is gitignored: it holds a bot token and the vault API key.

# --- Identity -----------------------------------------------------------
# Pins the agent image tag. Without it the tag is sha1(cwd)[:8], so it would
# change if the deploy path ever moved and NanoClaw would look for an image
# that does not exist. Must match the built image:
#   nanoclaw-agent-v2-<this value>:latest
NANOCLAW_INSTALL_ID=cortana-nas

TZ=America/New_York

# --- OneCLI vault -------------------------------------------------------
# Container-name form. The gateway publishes on the host IP, which a container
# on a user bridge cannot route back to — both that and host-gateway fail.
ONECLI_URL=http://onecli-api:10256
# Vault API key (oc_...). SECRET.
ONECLI_API_KEY=
# Default is "onecli"; the installed container is "onecli-gateway". A wrong
# value means NanoClaw cannot verify gateway attachment and refuses to spawn.
ONECLI_GATEWAY_CONTAINER=onecli-gateway

# --- Agent networking ---------------------------------------------------
# v2's designed mechanism for putting agent containers on a network where the
# gateway is reachable. Without it agents land on the default bridge, `gateway`
# does not resolve, and every Claude API call fails. onecli-sandboxes is
# already internal=true (no direct internet route, exactly what lockdown wants)
# with the gateway aliased `gateway`.
NANOCLAW_EGRESS_LOCKDOWN=true
NANOCLAW_EGRESS_NETWORK=onecli-sandboxes

# --- Channels -----------------------------------------------------------
# SECRET. The Telegram adapter reads this from the FILE via readEnvFile(), not
# from process.env — so .env must be mounted into the container, not just
# passed with env_file. See docker-compose.nanoclaw.yml.
TELEGRAM_BOT_TOKEN=

# Second bot identity, e.g. running Cortana alongside Nano. Each name needs
# TELEGRAM_BOT_TOKEN_<NAME> (uppercased, dashes to underscores).
#TELEGRAM_INSTANCES=cortana
#TELEGRAM_BOT_TOKEN_CORTANA=

# --- OAuth refresher (cutover only) -------------------------------------
# Vault secret id holding the Anthropic credential — `onecli secrets list`.
ONECLI_SECRET_ID=
